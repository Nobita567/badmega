# ─── Bot Tokens ────────────────────────────────────────────────────────────────
BOT1_TOKEN=your_main_bot_token_here
BOT2_TOKEN=your_preview_bot_token_here

# ─── Admin & Group ────────────────────────────────────────────────────────────
ADMIN_ID=123456789
GROUP_ID=-1001234567890

# ─── Bot Usernames (no @ prefix) ──────────────────────────────────────────────
MAIN_BOT_USERNAME=YourMainBotUsername
PREVIEW_BOT_USERNAME=YourPreviewBotUsername

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
